{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Appouse.Safetalk": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5080" }
    }
  },
  "Safetalk": {
    "AllowedClockSkew": "00:05:00",
    "MaxBodySize": 1048576,
    "EnableReplayProtection": true,
    "EnforcementMode": "AllRequests",
    "Clients": {
      "partner-a": "DEVELOPMENT-ONLY-secret-replace-with-32+-random-bytes"
    }
  }
}
