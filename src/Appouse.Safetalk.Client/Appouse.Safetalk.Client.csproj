<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Appouse.Safetalk.Client</RootNamespace>
    <Description>HttpClient integration for Appouse.Safetalk: a DelegatingHandler that signs outgoing requests with HMAC-SHA256 (X-Signature, X-Timestamp, X-Client-Id) and IHttpClientFactory registration helpers.</Description>
    <PackageTags>hmac;hmac-sha256;httpclient;delegatinghandler;request-signing;b2b;security</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Appouse.Safetalk.Core\Appouse.Safetalk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Appouse.Safetalk.Client.Tests" />
  </ItemGroup>

</Project>
