<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Appouse.Safetalk.Server</RootNamespace>
    <Description>ASP.NET Core integration for Appouse.Safetalk: a middleware that verifies HMAC-SHA256 signed requests (X-Signature, X-Timestamp, X-Client-Id) with replay protection and pluggable secret providers.</Description>
    <PackageTags>hmac;hmac-sha256;aspnetcore;middleware;request-signing;b2b;security;authentication</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Appouse.Safetalk.Core\Appouse.Safetalk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Appouse.Safetalk.Server.Tests" />
  </ItemGroup>

</Project>
